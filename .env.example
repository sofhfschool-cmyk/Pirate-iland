# Local Vite dev/preview: SQLite is created on first request in this persistent file.
SQLITE_PATH=.data/pi-rate-i-land.sqlite

# For a shared database on Vercel, set these two SERVER-ONLY environment variables.
# Without them the hosted demo uses a durable, per-browser IndexedDB database.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=

# Optional: set before initializing a shared database to replace the public demo
# administrator password and require it instead of one-click admin demo access.
# PIRATE_ADMIN_PASSWORD=
